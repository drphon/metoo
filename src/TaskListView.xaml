<UserControl x:Class="TodoClock.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TodoClock">
    <DockPanel>
        <!-- input row -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBox x:Name="NewTodo" Style="{StaticResource InputBox}" Padding="14,0,80,0"
                     KeyDown="NewTodo_KeyDown" MaxLength="300"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button x:Name="PendingDueBtn" Style="{StaticResource RoundButton}" Width="32" Height="32" Margin="0,0,4,0"
                        Click="PendingDue_Click" ToolTip="تاریخ انجام">
                    <Path x:Name="PendingDueIcon" Data="{StaticResource CalIcon}" Stroke="{StaticResource SubTextBrush}" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button Style="{StaticResource RoundButton}" Width="32" Height="32" Background="{StaticResource AccentGradient}"
                        Click="AddBtn_Click" ToolTip="اضافه کن">
                    <Path Data="M6,0 L6,12 M0,6 L12,6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- chosen due date for the next task -->
        <StackPanel x:Name="PendingRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,4" Visibility="Collapsed">
            <TextBlock Text="تاریخ کار بعدی:" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Border CornerRadius="9" Background="#2622D3EE" BorderBrush="#6622D3EE" BorderThickness="1" Padding="8,1">
                <TextBlock x:Name="PendingText" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button Style="{StaticResource RoundButton}" Width="20" Height="20" Margin="4,0,0,0" Background="Transparent"
                    Click="ClearPending_Click" ToolTip="بدون تاریخ">
                <Path Data="M0,0 L6,6 M6,0 L0,6" Stroke="#FB7185" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
        </StackPanel>

        <!-- footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="4,6,4,0" LastChildFill="False">
            <TextBlock x:Name="FooterText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource SubTextBrush}"/>
            <Button x:Name="ClearDoneBtn" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10,3"
                    Content="پاک کردن انجام شده ها" Click="ClearDone_Click"/>
            <ToggleButton x:Name="SortBtn" DockPanel.Dock="Right" Style="{StaticResource PillToggle}" Margin="0,0,6,0"
                          Content="ترتیب تاریخ" ToolTip="مرتب سازی بر اساس تاریخ انجام" Click="SortBtn_Click"/>
        </DockPanel>

        <Grid>
            <ScrollViewer x:Name="TodoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TodoList" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TodoItem}">
                            <Border x:Name="Row" CornerRadius="14" Padding="10,7" Margin="0,3" Background="#0FFFFFFF"
                                    BorderBrush="#12FFFFFF" BorderThickness="1">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource TodoCheck}" VerticalAlignment="Center"
                                              IsChecked="{Binding Done, Mode=TwoWay}"/>
                                    <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource RoundButton}"
                                            Width="26" Height="26" Background="Transparent" Opacity="0"
                                            Click="DeleteTodo_Click" ToolTip="پاک کردن" VerticalAlignment="Center">
                                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#FB7185" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Button>
                                    <Button x:Name="DueBtn" DockPanel.Dock="Right" Style="{StaticResource RoundButton}"
                                            Width="26" Height="26" Background="Transparent" Opacity="0"
                                            Click="SetDue_Click" ToolTip="تاریخ انجام" VerticalAlignment="Center">
                                        <Path Data="{StaticResource CalIcon}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.LayoutTransform><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Path.LayoutTransform>
                                        </Path>
                                    </Button>
                                    <StackPanel Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Txt" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                   FlowDirection="{Binding Text, Converter={StaticResource DirConv}}"/>
                                        <Button x:Name="Chip" Style="{StaticResource DueChip}" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                Content="{Binding DueText}" Tag="{Binding DueState}" Click="SetDue_Click"
                                                ToolTip="تغییر تاریخ" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter TargetName="Txt" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="Txt" Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="Chip" Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasDue}" Value="True">
                                    <Setter TargetName="Chip" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DueState}" Value="overdue">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="#55FB7185"/>
                                    <Setter TargetName="Row" Property="Background" Value="#14FB7185"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DueState}" Value="today">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="#5522D3EE"/>
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Del" Property="Opacity" Value="1"/>
                                    <Setter TargetName="DueBtn" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Row" Property="Background" Value="#1CFFFFFF"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="EmptyTitleText" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="EmptySubText" HorizontalAlignment="Center" FontSize="12" Foreground="#7F8AB8" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
