<UserControl x:Class="TodoClock.ClockFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight">
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="200" x:Name="Face">
            <!-- glow halo -->
            <Ellipse Width="200" Height="200">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.45" RadiusX="0.62" RadiusY="0.62">
                        <GradientStop Color="#E0362A78" Offset="0"/>
                        <GradientStop Color="#D81B1F45" Offset="0.6"/>
                        <GradientStop Color="#E00C1226" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- gradient rim -->
            <Ellipse Width="194" Height="194" Canvas.Left="3" Canvas.Top="3" StrokeThickness="3">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22D3EE" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="0.5"/>
                        <GradientStop Color="#A855F7" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse Width="184" Height="184" Canvas.Left="8" Canvas.Top="8" Stroke="#18FFFFFF" StrokeThickness="1"/>
            <!-- glossy highlight -->
            <Ellipse Width="150" Height="84" Canvas.Left="25" Canvas.Top="9" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#2EFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Canvas x:Name="Ticks" IsHitTestVisible="False"/>

            <!-- info texts -->
            <TextBlock x:Name="TopText" Width="200" Canvas.Top="54" TextAlignment="Center" FontSize="11"
                       Foreground="#C8D0F0" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}"/>
            <TextBlock x:Name="BottomText" Width="200" Canvas.Top="124" TextAlignment="Center" FontSize="17"
                       FontWeight="Bold" Foreground="#F1F5FF" FontFamily="{DynamicResource AppFont}"/>

            <!-- hands -->
            <Rectangle Width="6" Height="54" RadiusX="3" RadiusY="3" Canvas.Left="97" Canvas.Top="52" Fill="#F5F7FF">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="HourRot" CenterX="3" CenterY="48"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="4" Height="78" RadiusX="2" RadiusY="2" Canvas.Left="98" Canvas.Top="28" Fill="#DDE4FF">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="MinRot" CenterX="2" CenterY="72"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="2" Height="96" RadiusX="1" RadiusY="1" Canvas.Left="99" Canvas.Top="18" Fill="#22D3EE">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="SecRot" CenterX="1" CenterY="82"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Ellipse Width="12" Height="12" Canvas.Left="94" Canvas.Top="94" Fill="#22D3EE"/>
            <Ellipse Width="5" Height="5" Canvas.Left="97.5" Canvas.Top="97.5" Fill="#0C1226"/>
        </Canvas>
    </Viewbox>
</UserControl>
