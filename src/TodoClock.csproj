<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TodoClock</AssemblyName>
    <RootNamespace>TodoClock</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <Product>TodoClock</Product>
    <Company>Foad</Company>
    <Description>Floating Tehran clock with Shamsi/Gregorian calendar and todo list</Description>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Fonts\Vazirmatn-Medium.ttf" />
    <Resource Include="Fonts\Vazirmatn-Bold.ttf" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="TodoClock.app.ico" />
  </ItemGroup>
</Project>
